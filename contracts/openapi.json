  "components": {
    "schemas": {
      "Activity": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCEEDED",
              "FAILED"
            ],
            "title": "Status"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "tool",
          "status",
          "summary",
          "created_at"
        ],
        "title": "Activity"
      },
      "Assessment": {
        "type": "string",
        "enum": [
          "UNRESOLVED",
          "PROGRESS",
          "NEEDS_REVIEW"
        ],
        "title": "Assessment"
      },
      "AssistanceMode": {
        "type": "string",
        "enum": [
          "HINTS",
          "CONCEPTS",
          "ATTEMPT_REVIEW"
        ],
        "title": "AssistanceMode"
      },
      "AttemptCreate": {
        "properties": {
          "milestone_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Milestone Id"
          },
          "explanation": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Explanation"
          },
          "code": {
            "type": "string",
            "maxLength": 16000,
            "title": "Code",
            "default": ""
          },
          "file_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "File Paths"
          },
          "test_output": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Output"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "milestone_id",
          "explanation"
        ],
        "title": "AttemptCreate"
      },
      "AttemptOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "milestone_id": {
            "type": "string",
            "title": "Milestone Id"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "file_paths": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "File Paths"
          },
          "test_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Output"
          },
          "assessment": {
            "$ref": "#/components/schemas/Assessment"
          },
          "assessment_note": {
            "type": "string",
            "title": "Assessment Note"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "milestone_id",
          "explanation",
          "code",
          "file_paths",
          "test_output",
          "assessment",
          "assessment_note",
          "created_at"
        ],
        "title": "AttemptOut"
      },
      "CaseList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EscalationSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "CaseList"
      },
      "CaseStatus": {
        "type": "string",
        "enum": [
          "OPEN",
          "RESOLVED"
        ],
        "title": "CaseStatus"
      },
      "Citation": {
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uuid",
            "title": "Source Id"
          },
          "path": {
            "type": "string",
            "title": "Path"
          },
          "commit_sha": {
            "type": "string",
            "title": "Commit Sha"
          },
          "start_line": {
            "type": "integer",
            "title": "Start Line"
          },
          "end_line": {
            "type": "integer",
            "title": "End Line"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "path",
          "commit_sha",
          "start_line",
          "end_line",
          "excerpt",
          "url"
        ],
        "title": "Citation"
      },
      "CompletionDecision": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Version"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          }
